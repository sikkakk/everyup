/* 에브리업 셀프 체크리스트 전용 Google Apps Script 백엔드 */
const CHECKLIST_CONFIG = {
  spreadsheetId: '__SPREADSHEET_ID__',
  staffSheet: '직원명단',
  itemSheet: '체크리스트항목',
  logSheet: '체크리스트기록',
  directorName: '__DIRECTOR_NAME__',
  timeZone: 'Asia/Seoul',
  tokenSeconds: 21600
};

function doGet(e) {
  const p = e && e.parameter ? e.parameter : {};
  let result;
  try {
    if (p.action === 'auth') result = checklistAuth_(p.name, p.pw);
    else if (p.action === 'load') result = checklistLoad_(p.token, p.targetUser);
    else result = {ok:false, msg:'지원하지 않는 요청입니다.'};
  } catch (err) {
    result = {ok:false, msg:String(err && err.message || err)};
  }
  return checklistOutput_(result, p.callback);
}

function doPost(e) {
  let result;
  try {
    const body = JSON.parse(e.postData && e.postData.contents || '{}');
    if (body.action === 'toggle') result = checklistToggle_(body);
    else if (body.action === 'addItem') result = checklistAddItem_(body);
    else if (body.action === 'deleteItem') result = checklistDeleteItem_(body);
    else result = {ok:false, msg:'지원하지 않는 요청입니다.'};
  } catch (err) {
    result = {ok:false, msg:String(err && err.message || err)};
  }
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}

function checklistOutput_(obj, callback) {
  const json = JSON.stringify(obj);
  const safe = String(callback || '').replace(/[^a-zA-Z0-9_$]/g, '');
  return ContentService.createTextOutput(safe ? safe + '(' + json + ')' : json)
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function checklistBook_() { return SpreadsheetApp.openById(CHECKLIST_CONFIG.spreadsheetId); }

function checklistStaff_() {
  const rows = checklistBook_().getSheetByName(CHECKLIST_CONFIG.staffSheet).getDataRange().getDisplayValues();
  return rows.slice(1).filter(r => r[0]).map(r => ({name:String(r[0]).trim(), part:String(r[1]).trim(), pw:String(r[2]).trim()}));
}

function checklistRole_(part) {
  const p = String(part || '');
  if (p.indexOf('원장') >= 0) return '원장';
  if (p.indexOf('실장') >= 0) return '총괄상담실장';
  if (p.indexOf('코디') >= 0 || p.indexOf('리셉션') >= 0) return '코디네이터';
  if (p.indexOf('간호') >= 0) return '간호조무사';
  if (p.indexOf('피부') >= 0) return '피부관리사';
  return p;
}

function checklistAuth_(name, pw) {
  const user = checklistStaff_().find(x => x.name === String(name || '').trim());
  if (!user || user.pw !== String(pw || '').trim()) return {ok:false, code:'AUTH', msg:'로그인 정보가 맞지 않습니다.'};
  const token = Utilities.getUuid().replace(/-/g,'') + Utilities.getUuid().replace(/-/g,'');
  const session = {name:user.name, part:user.part, role:checklistRole_(user.part), isAdmin:user.name === CHECKLIST_CONFIG.directorName || user.part.indexOf('원장') >= 0};
  CacheService.getScriptCache().put('cl_' + token, JSON.stringify(session), CHECKLIST_CONFIG.tokenSeconds);
  return {ok:true, token:token, name:session.name, part:session.part, isAdmin:session.isAdmin};
}

function checklistSession_(token) {
  const raw = CacheService.getScriptCache().get('cl_' + String(token || ''));
  if (!raw) throw new Error('AUTH:로그인이 만료되었습니다.');
  CacheService.getScriptCache().put('cl_' + token, raw, CHECKLIST_CONFIG.tokenSeconds);
  return JSON.parse(raw);
}

function checklistItems_() {
  const rows = checklistBook_().getSheetByName(CHECKLIST_CONFIG.itemSheet).getDataRange().getValues();
  return rows.slice(1).filter(r => r[0] && String(r[5]).toLowerCase() !== 'false' && r[5] !== false).map(r => ({
    itemId:String(r[0]), role:String(r[1]), cycle:String(r[2]), text:String(r[3]), sortOrder:Number(r[4]) || 0
  }));
}

function checklistLoad_(token, targetUser) {
  let s;
  try { s = checklistSession_(token); } catch (e) { return {ok:false, code:'AUTH', msg:'로그인이 만료되었습니다.'}; }
  const staff = checklistStaff_().map(x => ({name:x.name, part:x.part, role:checklistRole_(x.part)}));
  let view = {name:s.name, part:s.part, role:s.role};
  if (s.isAdmin && targetUser) {
    const found = staff.find(x => x.name === String(targetUser));
    if (found) view = found;
  }
  const items = checklistItems_().filter(x => x.role === view.role).sort((a,b) => a.sortOrder-b.sortOrder);
  const wanted = {};
  items.forEach(x => wanted[x.itemId + '|' + checklistPeriod_(x.cycle)] = true);
  const sheet = checklistBook_().getSheetByName(CHECKLIST_CONFIG.logSheet);
  const rows = sheet.getLastRow() < 2 ? [] : sheet.getRange(2,1,sheet.getLastRow()-1,8).getValues();
  const records = {};
  rows.forEach(r => {
    const key = String(r[1]) + '|' + String(r[4]);
    if (String(r[2]) !== view.name || !wanted[key]) return;
    records[String(r[1])] = {checked:r[5] === true || String(r[5]).toLowerCase() === 'true', actionAt:r[6] instanceof Date ? r[6].toISOString() : String(r[6]), actionBy:String(r[7]), periodKey:String(r[4])};
  });
  return {ok:true, isAdmin:s.isAdmin, viewUser:view.name, viewRole:view.part, items:items, records:records, staff:s.isAdmin?staff:[]};
}

function checklistToggle_(body) {
  const s = checklistSession_(body.token);
  const item = checklistItems_().find(x => x.itemId === String(body.itemId));
  if (!item || item.role !== s.role) throw new Error('본인의 체크리스트만 수정할 수 있습니다.');
  const now = new Date();
  checklistBook_().getSheetByName(CHECKLIST_CONFIG.logSheet).appendRow([
    Utilities.getUuid(), item.itemId, s.name, s.part, checklistPeriod_(item.cycle, now), body.checked === true || String(body.checked) === 'true', now, s.name
  ]);
  return {ok:true};
}

function checklistAddItem_(body) {
  const s = checklistSession_(body.token);
  if (!s.isAdmin) throw new Error('원장님만 항목을 추가할 수 있습니다.');
  const role = String(body.role || '').trim(), cycle = String(body.cycle || '').trim(), text = String(body.text || '').trim();
  const roles = ['코디네이터','총괄상담실장','간호조무사','피부관리사','원장'];
  const cycles = ['매일','오전','관리중','오후','매주','매월','분기','필요시'];
  if (roles.indexOf(role) < 0 || cycles.indexOf(cycle) < 0 || !text) throw new Error('입력 내용을 확인해주세요.');
  const sh = checklistBook_().getSheetByName(CHECKLIST_CONFIG.itemSheet);
  const id = 'CHK-' + Utilities.getUuid().slice(0,8).toUpperCase();
  sh.appendRow([id,role,cycle,text,sh.getLastRow(),true,new Date(),s.name,'','']);
  return {ok:true, itemId:id};
}

function checklistDeleteItem_(body) {
  const s = checklistSession_(body.token);
  if (!s.isAdmin) throw new Error('원장님만 항목을 삭제할 수 있습니다.');
  const sh = checklistBook_().getSheetByName(CHECKLIST_CONFIG.itemSheet);
  const vals = sh.getRange(2,1,Math.max(0,sh.getLastRow()-1),10).getValues();
  const idx = vals.findIndex(r => String(r[0]) === String(body.itemId));
  if (idx < 0) throw new Error('항목을 찾을 수 없습니다.');
  const row = idx + 2;
  sh.getRange(row,6).setValue(false);
  sh.getRange(row,9,1,2).setValues([[new Date(),s.name]]);
  return {ok:true};
}

function checklistPeriod_(cycle, date) {
  const d = date || new Date(), tz = CHECKLIST_CONFIG.timeZone, c = String(cycle || '');
  const day = Utilities.formatDate(d,tz,'yyyy-MM-dd');
  if (c === '매주') {
    const localNoon = new Date(Utilities.formatDate(d,tz,"yyyy-MM-dd'T'12:00:00XXX"));
    const dow = Number(Utilities.formatDate(localNoon,tz,'u'));
    localNoon.setDate(localNoon.getDate() - dow + 1);
    return 'W:' + Utilities.formatDate(localNoon,tz,'yyyy-MM-dd');
  }
  if (c === '매월') return 'M:' + Utilities.formatDate(d,tz,'yyyy-MM');
  if (c === '분기') return 'Q:' + Utilities.formatDate(d,tz,'yyyy') + '-Q' + (Math.floor((Number(Utilities.formatDate(d,tz,'M'))-1)/3)+1);
  return 'D:' + day;
}
